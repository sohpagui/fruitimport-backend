# ============================================================
# FICHIER : .env.example
# Copier ce fichier en .env et remplir les valeurs
# ============================================================

# Base de données MySQL
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/fruitimport_db"

# JWT - Clés secrètes (générer avec: openssl rand -base64 64)
JWT_SECRET="votre_secret_jwt_tres_long_et_securise"
JWT_REFRESH_SECRET="votre_secret_refresh_jwt_different"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Serveur
PORT=3000
NODE_ENV="development"

# Upload fichiers
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=5242880

# Firebase (pour les notifications push)
FIREBASE_PROJECT_ID="votre_project_id"
FIREBASE_PRIVATE_KEY="votre_private_key"
FIREBASE_CLIENT_EMAIL="votre_client_email"
