// ============================================================
// FICHIER : prisma/schema.prisma
// Rôle : Définit toute la structure de la base de données.
//        Prisma lit ce fichier et génère :
//        1. Les tables MySQL via les migrations
//        2. Un client TypeScript typé pour faire des requêtes
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ÉNUMÉRATIONS
// Ce sont des listes de valeurs fixes autorisées pour certains champs
// ============================================================

// Rôles des utilisateurs dans le système
enum Role {
  PDG
  SECRETAIRE
  MAGASINIER
  LIVREUR
  CLIENT_PARTICULIER
  CLIENT_SUPERMARCHE
}

// Les deux agences de l'entreprise
enum NomAgence {
  DOUALA
  YAOUNDE
}

// Origines des fruits importés
enum Origine {
  MAROC
  AFRIQUE_DU_SUD
  ITALIE
  AUTRE
}

// Catégories de stock
enum CategorieStock {
  NORMAL
  SOLDE
}

// Raisons de perte de marchandise
enum RaisonPerte {
  JAUNISSEMENT
  POURRISSEMENT
  CHOC
  AUTRE
}

// Types de clients
enum TypeClient {
  PARTICULIER
  SUPERMARCHE
}

// Statut du crédit d'un client
enum StatutCredit {
  EN_REGLE
  A_RELANCER
  EN_RETARD
}

// Modes de paiement
enum ModePaiement {
  ESPECES
  CREDIT
}

// Statuts d'une commande
enum StatutCommande {
  EN_ATTENTE
  CONFIRMEE
  PREPAREE
  EN_LIVRAISON
  LIVREE
  ANNULEE
}

// Statuts d'une livraison
enum StatutLivraison {
  PREPARE
  EN_ROUTE
  LIVRE
  PROBLEME
}

// Statuts d'un transfert inter-agences
enum StatutTransfert {
  EN_ATTENTE
  APPROUVE
  REJETE
}

// Types de notifications
enum TypeNotification {
  CREDIT_ECHEANCE      // Échéance de crédit qui approche
  NOUVELLE_COMMANDE    // Nouvelle commande client à valider
  STOCK_BAS            // Alerte stock faible
  TRANSFERT_DEMANDE    // Nouvelle demande de transfert
  TRANSFERT_APPROUVE   // Transfert approuvé
  TRANSFERT_REJETE     // Transfert rejeté
  LIVRAISON_ASSIGNEE   // Une livraison a été assignée au livreur
}

// ============================================================
// TABLE : agences
// Les deux agences de l'entreprise : Douala et Yaoundé
// ============================================================
model Agence {
  id        Int       @id @default(autoincrement())
  nom       NomAgence @unique           // DOUALA ou YAOUNDE
  ville     String    @db.VarChar(100)
  adresse   String    @db.VarChar(255)
  telephone String    @db.VarChar(20)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relations : une agence a plusieurs...
  users           User[]               // employés
  stocks          Stock[]              // stocks
  receptions      ReceptionMarchandise[]
  pertes          Perte[]
  commandesSource Commande[]           // commandes passées dans cette agence
  transfertsSource Transfert[]         @relation("TransfertSource")
  transfertsDest  Transfert[]          @relation("TransfertDestination")
  clients         Client[]             // clients rattachés à cette agence

  @@map("agences")
}

// ============================================================
// TABLE : users
// Tous les utilisateurs : PDG, employés et clients internes
// Les vrais clients (ext.) sont dans la table clients
// ============================================================
model User {
  id             Int      @id @default(autoincrement())
  nom            String   @db.VarChar(100)
  telephone      String   @unique @db.VarChar(20)
  email          String?  @unique @db.VarChar(150)  // optionnel pour livreurs/magasiniers
  motDePasseHash String   @map("mot_de_passe_hash") @db.VarChar(255)
  role           Role
  agenceId       Int?     @map("agence_id")         // null pour le PDG
  actif          Boolean  @default(true)
  creePar        Int?     @map("cree_par_id")        // null pour le PDG (premier compte)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  agence            Agence?        @relation(fields: [agenceId], references: [id])
  createur          User?          @relation("UserCreePar", fields: [creePar], references: [id])
  comptesCreees     User[]         @relation("UserCreePar")
  commandesCreees   Commande[]     @relation("CommandeCreePar")
  livraisons        Livraison[]    @relation("LivreurLivraison")
  transfertsDemandes Transfert[]   @relation("TransfertDemandePar")
  transfertsValides  Transfert[]   @relation("TransfertValidePar")
  receptionsCreees  ReceptionMarchandise[]
  pertesDeclarees   Perte[]
  paiementsEnregistres PaiementCredit[]
  versementsEnregistres VersementCredit[]
  notifications     Notification[]
  logsActions       LogAction[]

  @@index([agenceId])
  @@index([role])
  @@map("users")
}

// ============================================================
// TABLE : fruits
// Les types de fruits importés par l'entreprise
// ============================================================
model Fruit {
  id           Int    @id @default(autoincrement())
  nom          String @unique @db.VarChar(100)  // ex: "Pomme Rouge", "Kiwi"
  uniteMesure  String @map("unite_mesure") @db.VarChar(20)  // "carton" ou "kg"
  createdAt    DateTime @default(now())

  // Relations
  calibres   Calibre[]
  stocks     Stock[]
  receptions ReceptionMarchandise[]
  pertes     Perte[]
  lignesCommande LigneCommande[]
  transferts Transfert[]

  @@map("fruits")
}

// ============================================================
// TABLE : calibres
// Chaque fruit peut avoir plusieurs calibres
// Ex: Pomme Rouge → calibre 100, calibre 120, calibre 138
// ============================================================
model Calibre {
  id              Int    @id @default(autoincrement())
  fruitId         Int    @map("fruit_id")
  valeur          String @db.VarChar(50)   // ex: "100", "8.5kg", "cal.3"
  ordreAffichage  Int    @default(0) @map("ordre_affichage")

  // Relations
  fruit          Fruit    @relation(fields: [fruitId], references: [id], onDelete: Cascade)
  stocks         Stock[]
  receptions     ReceptionMarchandise[]
  pertes         Perte[]
  lignesCommande LigneCommande[]
  transferts     Transfert[]

  @@index([fruitId])
  @@map("calibres")
}

// ============================================================
// TABLE : stocks
// Quantité disponible par agence/fruit/calibre/origine/catégorie
// C'est la table centrale du système de gestion
// ============================================================
model Stock {
  id              Int            @id @default(autoincrement())
  agenceId        Int            @map("agence_id")
  fruitId         Int            @map("fruit_id")
  calibreId       Int            @map("calibre_id")
  origine         Origine
  categorie       CategorieStock @default(NORMAL)
  quantiteCartons Int            @default(0) @map("quantite_cartons")
  prixUnitaire    Decimal        @map("prix_unitaire") @db.Decimal(10, 2)
  dateDerniereMaj DateTime       @default(now()) @map("date_derniere_maj")

  // Relations
  agence  Agence  @relation(fields: [agenceId], references: [id])
  fruit   Fruit   @relation(fields: [fruitId], references: [id])
  calibre Calibre @relation(fields: [calibreId], references: [id])

  // Un stock est unique par combinaison agence+fruit+calibre+origine+catégorie
  @@unique([agenceId, fruitId, calibreId, origine, categorie])
  @@index([agenceId])
  @@index([fruitId])
  @@map("stocks")
}

// ============================================================
// TABLE : receptions_marchandise
// Enregistre chaque arrivée de marchandise dans une agence
// ============================================================
model ReceptionMarchandise {
  id            Int      @id @default(autoincrement())
  agenceId      Int      @map("agence_id")
  fruitId       Int      @map("fruit_id")
  calibreId     Int      @map("calibre_id")
  origine       Origine
  cartonsNormal Int      @map("cartons_normal")
  cartonsSolde  Int      @default(0) @map("cartons_solde")
  prixNormal    Decimal  @map("prix_normal") @db.Decimal(10, 2)
  prixSolde     Decimal? @map("prix_solde") @db.Decimal(10, 2)
  dateArrivee   DateTime @default(now()) @map("date_arrivee")
  recuParId     Int      @map("recu_par_id")

  // Relations
  agence  Agence  @relation(fields: [agenceId], references: [id])
  fruit   Fruit   @relation(fields: [fruitId], references: [id])
  calibre Calibre @relation(fields: [calibreId], references: [id])
  recuPar User    @relation(fields: [recuParId], references: [id])

  @@index([agenceId])
  @@index([dateArrivee])
  @@map("receptions_marchandise")
}

// ============================================================
// TABLE : pertes
// Déclare les pertes de marchandise (fruits abîmés, etc.)
// ============================================================
model Perte {
  id            Int         @id @default(autoincrement())
  agenceId      Int         @map("agence_id")
  fruitId       Int         @map("fruit_id")
  calibreId     Int         @map("calibre_id")
  quantite      Int
  raison        RaisonPerte
  valeurPerdue  Decimal     @map("valeur_perdue") @db.Decimal(10, 2)
  date          DateTime    @default(now())
  declarePar    Int         @map("declare_par_id")

  // Relations
  agence    Agence  @relation(fields: [agenceId], references: [id])
  fruit     Fruit   @relation(fields: [fruitId], references: [id])
  calibre   Calibre @relation(fields: [calibreId], references: [id])
  declarant User    @relation(fields: [declarePar], references: [id])

  @@index([agenceId])
  @@index([date])
  @@map("pertes")
}

// ============================================================
// TABLE : clients
// Clients externes de l'entreprise (particuliers et supermarchés)
// Ils s'inscrivent eux-mêmes via l'application
// ============================================================
model Client {
  id            Int          @id @default(autoincrement())
  nom           String       @db.VarChar(150)
  type          TypeClient
  agenceId      Int          @map("agence_id")   // agence de référence
  telephone     String       @unique @db.VarChar(20)
  email         String?      @unique @db.VarChar(150)
  adresse       String?      @db.VarChar(255)
  motDePasseHash String      @map("mot_de_passe_hash") @db.VarChar(255)
  limiteCredit  Decimal      @default(0) @map("limite_credit") @db.Decimal(10, 2)
  creditUtilise Decimal      @default(0) @map("credit_utilise") @db.Decimal(10, 2)
  statutCredit  StatutCredit @default(EN_REGLE) @map("statut_credit")
  dateEcheance  DateTime?    @map("date_echeance")
  tauxInteretMensuel Decimal @default(0) @map("taux_interet_mensuel") @db.Decimal(5, 2)
  actif         Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  // Relations
  agence         Agence           @relation(fields: [agenceId], references: [id])
  commandes      Commande[]
  paiementsCredit PaiementCredit[]
  versementsCredit VersementCredit[]
  notifications  NotificationClient[]

  @@index([agenceId])
  @@index([statutCredit])
  @@map("clients")
}

// ============================================================
// TABLE : commandes
// Une commande peut être créée par une secrétaire ou un client
// ============================================================
model Commande {
  id              Int            @id @default(autoincrement())
  numero          String         @unique @db.VarChar(20)  // ex: BC-2026-001
  agenceId        Int            @map("agence_id")
  clientId        Int            @map("client_id")
  creeParId       Int?           @map("cree_par_id")      // null si créée par le client lui-même
  date            DateTime       @default(now())
  modePaiement    ModePaiement   @map("mode_paiement")
  statut          StatutCommande @default(EN_ATTENTE)
  montantTotal    Decimal        @map("montant_total") @db.Decimal(10, 2)
  adresseLivraison String?       @map("adresse_livraison") @db.VarChar(255)
  note            String?        @db.Text
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Relations
  agence       Agence          @relation(fields: [agenceId], references: [id])
  client       Client          @relation(fields: [clientId], references: [id])
  creePar      User?           @relation("CommandeCreePar", fields: [creeParId], references: [id])
  lignes       LigneCommande[]
  livraison    Livraison?
  paiements    PaiementCredit[]

  @@index([agenceId])
  @@index([clientId])
  @@index([statut])
  @@index([date])
  @@map("commandes")
}

// ============================================================
// TABLE : lignes_commande
// Détail de chaque article dans une commande
// ============================================================
model LigneCommande {
  id          Int            @id @default(autoincrement())
  commandeId  Int            @map("commande_id")
  fruitId     Int            @map("fruit_id")
  calibreId   Int            @map("calibre_id")
  categorie   CategorieStock
  quantite    Int
  prixUnitaire Decimal       @map("prix_unitaire") @db.Decimal(10, 2)
  sousTotal   Decimal        @map("sous_total") @db.Decimal(10, 2)

  // Relations
  commande Commande @relation(fields: [commandeId], references: [id], onDelete: Cascade)
  fruit    Fruit    @relation(fields: [fruitId], references: [id])
  calibre  Calibre  @relation(fields: [calibreId], references: [id])

  @@index([commandeId])
  @@map("lignes_commande")
}

// ============================================================
// TABLE : livraisons
// Gestion des livraisons assignées aux livreurs
// ============================================================
model Livraison {
  id              Int             @id @default(autoincrement())
  commandeId      Int             @unique @map("commande_id")  // une commande = une livraison
  livreurId       Int             @map("livreur_id")
  statut          StatutLivraison @default(PREPARE)
  noteProbleme    String?         @map("note_probleme") @db.Text
  dateAssignation DateTime        @default(now()) @map("date_assignation")
  dateLivraison   DateTime?       @map("date_livraison")

  // Relations
  commande Commande @relation(fields: [commandeId], references: [id])
  livreur  User     @relation("LivreurLivraison", fields: [livreurId], references: [id])

  @@index([livreurId])
  @@index([statut])
  @@map("livraisons")
}

// ============================================================
// TABLE : transferts
// Transferts de marchandise entre agences (Douala → Yaoundé)
// ============================================================
model Transfert {
  id                  Int             @id @default(autoincrement())
  agenceSourceId      Int             @map("agence_source_id")
  agenceDestinationId Int             @map("agence_destination_id")
  fruitId             Int             @map("fruit_id")
  calibreId           Int             @map("calibre_id")
  quantite            Int
  statut              StatutTransfert @default(EN_ATTENTE)
  demandePar          Int             @map("demande_par_id")
  validePar           Int?            @map("valide_par_id")
  dateDemande         DateTime        @default(now()) @map("date_demande")
  dateValidation      DateTime?       @map("date_validation")
  note                String?         @db.Text

  // Relations
  agenceSource      Agence  @relation("TransfertSource", fields: [agenceSourceId], references: [id])
  agenceDestination Agence  @relation("TransfertDestination", fields: [agenceDestinationId], references: [id])
  fruit             Fruit   @relation(fields: [fruitId], references: [id])
  calibre           Calibre @relation(fields: [calibreId], references: [id])
  demandeur         User    @relation("TransfertDemandePar", fields: [demandePar], references: [id])
  validateur        User?   @relation("TransfertValidePar", fields: [validePar], references: [id])

  @@index([statut])
  @@index([agenceSourceId])
  @@map("transferts")
}

// ============================================================
// TABLE : paiements_credit
// Enregistre les remboursements des clients en crédit
// ============================================================
model PaiementCredit {
  id              Int      @id @default(autoincrement())
  clientId        Int      @map("client_id")
  commandeId      Int?     @map("commande_id")   // null = paiement global
  montant         Decimal  @db.Decimal(10, 2)
  date            DateTime @default(now())
  enregistrePar   Int      @map("enregistre_par_id")

  // Relations
  client        Client    @relation(fields: [clientId], references: [id])
  commande      Commande? @relation(fields: [commandeId], references: [id])
  enregistreur  User      @relation(fields: [enregistrePar], references: [id])

  @@index([clientId])
  @@map("paiements_credit")
}

// ============================================================
// TABLE : notifications
// Notifications pour les employés (users)
// ============================================================
model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int              @map("user_id")
  type      TypeNotification
  message   String           @db.Text
  lu        Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([lu])
  @@map("notifications")
}

// ============================================================
// TABLE : notifications_client
// Notifications pour les clients externes
// ============================================================
model NotificationClient {
  id        Int              @id @default(autoincrement())
  clientId  Int              @map("client_id")
  type      TypeNotification
  message   String           @db.Text
  lu        Boolean          @default(false)
  createdAt DateTime         @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("notifications_client")
}

// ============================================================
// TABLE : logs_actions
// Journal des actions sensibles (sécurité et audit)
// Ex: création de compte, approbation de transfert, etc.
// ============================================================
model LogAction {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  action    String   @db.VarChar(100)   // ex: "CREATION_COMPTE", "APPROBATION_TRANSFERT"
  details   String?  @db.Text           // JSON des données concernées
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@map("logs_actions")
}

// ============================================================
// TABLE : versements_credit
// Trace chaque versement d'un client avec le solde avant/après
// Permet au client de voir sa progression de remboursement
// ============================================================
model VersementCredit {
  id              Int      @id @default(autoincrement())
  clientId        Int      @map("client_id")
  montant         Decimal  @db.Decimal(10, 2)
  soldeAvant      Decimal  @map("solde_avant") @db.Decimal(10, 2)
  soldeApres      Decimal  @map("solde_apres") @db.Decimal(10, 2)
  enregistreParId Int      @map("enregistre_par_id")
  date            DateTime @default(now())

  client       Client @relation(fields: [clientId], references: [id])
  enregistrePar User  @relation(fields: [enregistreParId], references: [id])

  @@index([clientId])
  @@index([date])
  @@map("versements_credit")
}

// ============================================================
// TABLE : parametres_systeme
// Paramètres globaux configurables par le PDG
// Ex: taux d'intérêt par défaut sur les crédits en retard
// ============================================================
model ParametreSysteme {
  id    Int    @id @default(autoincrement())
  cle   String @unique @db.VarChar(100)
  valeur String @db.VarChar(255)

  @@map("parametres_systeme")
}
